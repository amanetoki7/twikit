{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "metadata": [
    {
      "src": [
        {
          "files": [ "Twikit/Twikit.csproj" ],
          "src": ".."
        }
      ],
      "dest": "api",
      "includePrivateMembers": false,
      "disableGitFeatures": false,
      "disableDefaultFilter": false,
      "noRestore": false,
      "namespaceLayout": "flattened",
      "memberLayout": "samePage",
      "enumSortOrder": "declaringOrder"
    }
  ],
  "build": {
    "content": [
      {
        "files": [ "api/**.yml", "api/index.md" ]
      },
      {
        "files": [ "articles/**.md", "articles/**/toc.yml", "toc.yml", "index.md" ]
      }
    ],
    "resource": [
      {
        "files": [ "images/**" ]
      }
    ],
    "output": "_site",
    "template": [ "default", "modern" ],
    "globalMetadata": {
      "_appName": "twikit (C#)",
      "_appTitle": "twikit C# 版ドキュメント",
      "_appFooter": "twikit C# 版 — API キー不要の Twitter / X API クライアント（MIT ライセンス）",
      "_enableSearch": true,
      "_lang": "ja",
      "_disableContribution": true,
      "pdf": false
    },
    "postProcessors": [],
    "keepFileLink": false,
    "disableGitFeatures": false
  }
}
